                'Value', true, 'Position', [5 476 240 22]);

            % Baseline wander
            app.BaselineCheck = uicheckbox(app.LeftPanel_ST, ...
                'Text', 'Baseline Wander (Düşük Frekans)', ...
                'Value', true, 'Position', [5 452 260 22]);

            % Oluştur butonu
            app.SentetikOlusturButton = uibutton(app.LeftPanel_ST, 'push', ...
                'Text', '  Sentetik EMG Oluştur', ...
                'Position', [5 415 265 35], ...
                'FontSize', 12, 'FontWeight', 'bold', ...
                'BackgroundColor', [0.2 0.4 0.8], 'FontColor', 'white', ...
                'ButtonPushedFcn', createCallbackFcn(app, @SentetikOlusturButtonPushed, true));

            % Filtre seçimi - sentetik için
            uilabel(app.LeftPanel_ST, 'Text', 'FİLTRE UYGULA', ...
                'Position', [5 378 260 20], 'FontWeight', 'bold', ...
                'FontColor', [0.3 0.3 0.6]);

            app.SenFiltreTipiDD = uidropdown(app.LeftPanel_ST, ...
                'Items', {'Butterworth (Bandpass)', 'Notch (50 Hz)', ...
                          'Wavelet (db4)', 'Tam Zincir (BP + Notch)'}, ...
                'Position', [5 350 265 26]);

            app.SenFiltreUygButton = uibutton(app.LeftPanel_ST, 'push', ...
                'Text', '  Filtreyi Uygula', ...
                'Position', [5 315 265 30], ...
                'FontSize', 11, 'FontWeight', 'bold', ...
                'BackgroundColor', [0.1 0.6 0.2], 'FontColor', 'white', ...
                'ButtonPushedFcn', createCallbackFcn(app, @SenFiltreUygButtonPushed, true));

            % Sentetik metrik paneli
            app.SenMetrikPanel = uipanel(app.LeftPanel_ST, ...
                'Title', 'Sentetik Sinyal Metrikleri', ...
                'Position', [3 5 270 295], ...
                'FontSize', 10, 'FontWeight', 'bold');

            sen_labels = {'SNR (referansa göre dB):', 'RMS (mV):', 'Median Freq (Hz):'};
            sen_props  = {'SenSNRDegLabel', 'SenRMSDegLabel', 'SenMFDegLabel'};
            for mi = 1:3
                y_pos = 265 - (mi-1)*50;
                uilabel(app.SenMetrikPanel, 'Text', sen_labels{mi}, ...
                    'Position', [5 y_pos 220 20], 'FontSize', 9, ...
                    'FontWeight', 'bold');
                app.(sen_props{mi}) = uilabel(app.SenMetrikPanel, ...
                    'Text', '-', ...
                    'Position', [5 y_pos-22 260 20], 'FontSize', 11, ...
                    'FontColor', [0.8 0.3 0.1], 'FontWeight', 'bold');
            end

            uilabel(app.SenMetrikPanel, 'Text', ...
                'SNR, temiz referans sinyal üzerinden hesaplanır.', ...
                'Position', [5 10 260 30], 'FontSize', 8, ...
                'FontColor', [0.5 0.5 0.5], 'WordWrap', 'on');

            % Sağ grafik paneli - sentetik
            app.RightPanel_ST = uipanel(app.SentetikTab, ...
                'Title', '', 'BorderType', 'none', ...
                'Position', [292 5 960 665]);

            app.SenHamAxes = uiaxes(app.RightPanel_ST, ...
                'Position', [5 445 950 210]);
            title(app.SenHamAxes, 'Sentetik Ham EMG (Gürültülü)');
            xlabel(app.SenHamAxes, 'Zaman (s)');
            ylabel(app.SenHamAxes, 'Genlik (mV)');
            grid(app.SenHamAxes, 'on');

            app.SenFiltAxes = uiaxes(app.RightPanel_ST, ...
                'Position', [5 225 950 210]);
            title(app.SenFiltAxes, 'Filtrelenmiş Sinyal');
            xlabel(app.SenFiltAxes, 'Zaman (s)');
            ylabel(app.SenFiltAxes, 'Genlik (mV)');
            grid(app.SenFiltAxes, 'on');

            app.SenPSDAxes = uiaxes(app.RightPanel_ST, ...
                'Position', [5 5 950 210]);
            title(app.SenPSDAxes, 'Güç Spektral Yoğunluğu');
            xlabel(app.SenPSDAxes, 'Frekans (Hz)');
            ylabel(app.SenPSDAxes, 'PSD');
            grid(app.SenPSDAxes, 'on');

            % Figürü görünür yap
            app.UIFigure.Visible = 'on';

        end  % createComponents

    end  % component init methods

    % =========================================================================
    %  APP BAŞLATMA ve KAPATMA
    % =========================================================================
    methods (Access = public)

        function app = DelsysNoiseMaster
            % Bileşenleri oluştur
            createComponents(app);
            % App Designer register
            registerApp(app, app.UIFigure);
            % İlk durum
            guncelleFiltreKontrolleri(app);
            if nargout == 0
                clear app;
            end
        end

        function delete(app)
            delete(app.UIFigure);
        end

    end

end  % classdef


% =========================================================================
%  YEREL YARDIMCI FONKSİYON: compute_median_freq
%  (Dosyanın sonuna eklenir, ayrı dosyaya gerek yok)
% =========================================================================
function mf = compute_median_freq(signal, fs)
    % Medyan frekans: güç spektrumunun yarısının bulunduğu frekans
    n   = length(signal);
    win = min(round(n/4), 1024);
    [pxx, f] = pwelch(signal, win, [], [], fs);
    cumulative = cumsum(pxx);
    half_total = cumulative(end) / 2;
    idx = find(cumulative >= half_total, 1, 'first');
    if isempty(idx)
        mf = 0;
    else
        mf = f(idx);
    end
end
